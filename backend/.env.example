# 서버 설정 예시. 값이 없으면 기본값을 사용한다.
# 로컬: cp .env.example .env 후 uvicorn app.main:app --reload --env-file .env
# Docker: 루트 docker-compose.yml의 environment 값이 우선한다.
APP_ENV=local
# 기본값: sqlite:///./cert_is.db  /  MySQL 예시: mysql+pymysql://certis:certis@127.0.0.1:3306/certis?charset=utf8mb4
DATABASE_URL=sqlite:///./cert_is.db
# 운영(APP_ENV=production)에서는 반드시 32자 이상 무작위 값으로 바꿀 것: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-cert-is-secret-change-me-in-production
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# python -m app.seed 로 만드는 샘플 계정 공통 비밀번호
SEED_PASSWORD=certis1234!
